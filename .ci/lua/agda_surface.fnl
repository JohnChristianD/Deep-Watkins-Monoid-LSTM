(local output-path (assert (. arg 1) "usage: agda_surface.fnl OUTPUT.elm"))
(local output (assert (io.open output-path "w")))
(local source "module GeneratedTheoremSurface exposing (siteTitle, sourceFiles, entryLines, russEntryLines, learnerEntryCount, theoremEntryCount)\n\nimport Char\nimport GeneratedMonolithContent as Content\nimport String\n\nsiteTitle : String\nsiteTitle =\n    \"The Monoid LSTM / Learner and Theorem Monoliths\"\n\nsourceFiles : List String\nsourceFiles =\n    Content.sourceFiles\n\nunique : List String -> List String\nunique values =\n    uniqueHelp values []\n\nuniqueHelp : List String -> List String -> List String\nuniqueHelp values seen =\n    case values of\n        [] ->\n            seen\n\n        value :: rest ->\n            if List.member value seen then\n                uniqueHelp rest seen\n\n            else\n                uniqueHelp rest (seen ++ [ value ])\n\nsanitizeChar : Char -> Char\nsanitizeChar char =\n    if Char.toCode char < 128 then\n        char\n\n    else\n        Char.fromCode 63\n\nasciiSanitize : String -> String\nasciiSanitize value =\n    String.map sanitizeChar value\n\nentryLine : Content.Entry -> String\nentryLine entry =\n    asciiSanitize\n        (entry.source\n            ++ \":\"\n            ++ String.fromInt entry.line\n            ++ \": \"\n            ++ entry.name\n            ++ \" : \"\n            ++ entry.signature\n        )\n\nentryLines : List String\nentryLines =\n    List.map entryLine Content.entries\n\nrussEntryLines : List String\nrussEntryLines =\n    Content.entries\n        |> List.filter (\\entry ->\n            String.contains \"RUSS\" entry.category\n                || String.contains \"trust boundary\" entry.category\n                || String.contains \"reflection / TC primitive\" entry.category\n        )\n        |> List.map entryLine\n\nisLearnerEntry : Content.Entry -> Bool\nisLearnerEntry entry =\n    String.endsWith \"CanonicalLearnerMonolith.agda\" entry.source\n\nlearnerEntryCount : Int\nlearnerEntryCount =\n    List.length (List.filter isLearnerEntry Content.entries)\n\ntheoremEntryCount : Int\ntheoremEntryCount =\n    List.length Content.entries - learnerEntryCount\n")
(output:write source)
(output:close)
(print (.. "Generated two-monolith catalog summary: " output-path))
