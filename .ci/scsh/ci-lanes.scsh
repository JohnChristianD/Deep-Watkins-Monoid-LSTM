#!/usr/bin/env scsh -s
!#
;; All repository CI orchestration lives here. Dhall declares lane names and
;; project policy; Scheme controls processes, files, checks, and lane dispatch.
;; No Bash command string is evaluated.

(define (fail message)
  (display "ci-lane=fail: ")
  (display message)
  (newline)
  (exit 1))

(define (trim s)
  (let ((n (string-length s)))
    (let left ((i 0))
      (if (and (< i n) (char-whitespace? (string-ref s i)))
          (left (+ i 1))
          (let right ((j n))
            (if (and (> j i) (char-whitespace? (string-ref s (- j 1))))
                (right (- j 1))
                (substring s i j)))))))

(define (read-file path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((chars '()))
        (let ((ch (read-char port)))
          (if (eof-object? ch)
              (list->string (reverse chars))
              (loop (cons ch chars))))))))

(define (write-file path content)
  (if (file-exists? path) (delete-file path))
  (call-with-output-file path
    (lambda (port) (display content port))))

(define (contains? text needle)
  (let ((n (string-length needle)) (size (string-length text)))
    (let loop ((i 0))
      (cond ((> (+ i n) size) #f)
            ((string=? (substring text i (+ i n)) needle) #t)
            (else (loop (+ i 1)))))))

(define (count-substring text needle)
  (let ((n (string-length needle)) (size (string-length text)))
    (let loop ((i 0) (count 0))
      (if (> (+ i n) size)
          count
          (if (string=? (substring text i (+ i n)) needle)
              (loop (+ i n) (+ count 1))
              (loop (+ i 1) count))))))


(define (strip-whitespace s)
  (list->string
    (let loop ((rest (string->list s)) (kept '()))
      (if (null? rest)
          (reverse kept)
          (if (char-whitespace? (car rest))
              (loop (cdr rest) kept)
              (loop (cdr rest) (cons (car rest) kept)))))))

(define (lines-of text)
  (let loop ((rest (string->list text)) (line '()) (lines '()))
    (cond ((null? rest)
           (reverse (if (null? line) lines
                        (cons (list->string (reverse line)) lines))))
          ((char=? (car rest) #\newline)
           (loop (cdr rest) '() (cons (list->string (reverse line)) lines)))
          (else (loop (cdr rest) (cons (car rest) line) lines)))))

(define (require-file path)
  (if (not (file-exists? path))
      (fail (string-append "missing file: " path))))

(define (forbid-file path)
  (if (file-exists? path)
      (fail (string-append "forbidden file remains: " path))))

(define (require-text path needle)
  (if (not (contains? (read-file path) needle))
      (fail (string-append path " lacks: " needle))))

(define (forbid-text path needle)
  (if (contains? (read-file path) needle)
      (fail (string-append path " contains forbidden text: " needle))))

(define (must-run action label)
  (let ((status (action)))
    (if (not (= status 0))
        (fail (string-append label " exited " (number->string status))))))

(define (regex-present? path pattern)
  (let ((status (run (grep "-Eq" ,pattern ,path))))
    (cond ((= status 0) #t)
          ((= status 1) #f)
          (else (fail (string-append "grep failed for " path))))))

(define (require-regex path pattern)
  (if (not (regex-present? path pattern))
      (fail (string-append path " does not match: " pattern))))

(define (forbid-regex path pattern)
  (if (regex-present? path pattern)
      (fail (string-append path " matches forbidden pattern: " pattern))))

(define (temporary-directory)
  (let ((path (trim (run/string (mktemp "-d")))))
    (if (= (string-length path) 0) (fail "mktemp returned an empty path"))
    path))

(define (agda-command)
  (or (getenv "AGDA_COMMAND") "agda2hs-agda"))

(define (check-agda path)
  (must-run (lambda () (run (,(agda-command) "-i" "." ,path)))
            (string-append "Agda " path)))

(define (nix-app app)
  (must-run (lambda () (run (nix run ,app)))
            (string-append "nix run " app)))

(define (require-symbols path symbols)
  (for-each (lambda (symbol) (require-text path symbol)) symbols))

(define (lane-agda-learner)
  (must-run (lambda () (run (,(agda-command) "--version"))) "Agda version")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "open import Haskell.Prelude")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russianRecursiveMathematicsAssumptions")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russMarkov")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russECT0")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russCountableChoice")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "--with-K")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "--no-guardedness")
  (for-each
    (lambda (needle)
      (forbid-text "FullCoupled/CanonicalLearnerMonolith.agda" needle))
    '("open import Cubical." "open import Cubical "
      "import Cubical." "import Cubical "))
  (check-agda "FullCoupled/CanonicalLearnerMonolith.agda")
  (display "canonical-learner=kernel-checked-relative-to-imports-and-explicit-RUSS-basis\n"))

(define (lane-agda-theorem)
  (for-each require-file
    '("FullCoupled/CanonicalLearnerMonolith.agda"
      "FullCoupled/TheoremsMonolith.agda"))
  (require-text "FullCoupled/TheoremsMonolith.agda" "module RUSSProofTheory where")
  (require-text "FullCoupled/TheoremsMonolith.agda" "russSoundness")
  (require-text "FullCoupled/TheoremsMonolith.agda" "russCoreConsistency")
  (require-text "FullCoupled/TheoremsMonolith.agda" "russCurrentBasisRelativeConsistency")
  (require-text "FullCoupled/TheoremsMonolith.agda" "russMarkovOperationalPrefix")
  (require-text "FullCoupled/TheoremsMonolith.agda" "russECT0CertifiedProgram")
  (require-text "FullCoupled/TheoremsMonolith.agda" "russPropCountableSelector")
  (require-text "FullCoupled/TheoremsMonolith.agda" "russDataCountableSelector")
  (require-text "FullCoupled/TheoremsMonolith.agda" "--with-K")
  (require-text "FullCoupled/TheoremsMonolith.agda" "--no-guardedness")
  (check-agda "FullCoupled/CanonicalLearnerMonolith.agda")
  (check-agda "FullCoupled/TheoremsMonolith.agda")
  (display "russ-computation=explicit-bounded-search-register-machine-and-choice-interfaces\n")
  (display "russ-meta-result=relative-object-calculus-consistency-only\n")
  (display "joint-repository-consistency=NOT-PROVED\n"))

(define (verify-catalog path)
  (require-file path)
  (must-run (lambda () (run (node "--check" ,path))) "catalog JavaScript syntax")
  (require-text path "export const MonolithContent = Object.freeze")
  (require-text path "sourceFiles: Object.freeze")
  (require-text path "entries: Object.freeze")
  (require-text path "FullCoupled/CanonicalLearnerMonolith.agda")
  (require-text path "FullCoupled/TheoremsMonolith.agda"))

(define (lane-pages)
  (for-each require-file
    '("FullCoupled/CanonicalLearnerMonolith.agda"
      "FullCoupled/TheoremsMonolith.agda"
      ".ci/presentation-contract.dhall"
      ".ci/fennel/monolith_catalog.fnl"
      ".ci/fennel/palette_css.fnl"
      ".ci/presentation-smoke.cjs"
      "site/app.mjs"
      "site/render.mjs"
      "site/page-model.mjs"
      "site/site.less"
      "index.html"))
  (must-run
    (lambda () (run (dhall "type" "--file" ".ci/presentation-contract.dhall")))
    "type presentation contract")
  (for-each
    (lambda (needle)
      (forbid-text "site/render.mjs" needle))
    '("node:fs" "process.argv" "writeFile" "readFile" "console."
      "globalThis" "Date.now" "Math.random"
      "addEventListener" "querySelector"))
  (for-each
    (lambda (needle)
      (forbid-text "site/app.mjs" needle))
    '("filterEntries" "addEventListener" "querySelector" "siteSearchMatches"))
  (for-each
    (lambda (needle)
      (forbid-text "index.html" needle))
    '("<script" "<input" "<button" "search" "filter"))
  (require-text "site/site.less" "Atkinson Hyperlegible Mono")
  (require-text "site/site.less" "Iosevka")
  (require-text ".ci/fennel/palette_css.fnl" "0.7328")
  (require-text ".ci/fennel/palette_css.fnl" "0.4296")
  (require-text ".ci/fennel/palette_css.fnl" "0.9834")
  (let* ((temporary (temporary-directory))
         (output-dir (or (getenv "PAGES_OUTPUT_DIR") "build/pages"))
         (css (string-append output-dir "/site.css"))
         (palette (string-append temporary "/palette.css"))
         (catalog (string-append temporary "/monolith-content.mjs"))
         (html (string-append output-dir "/index.html")))
    (must-run (lambda () (run (mkdir "-p" ,output-dir))) "create Pages output directory")
    (must-run (lambda () (run (lessc "site/site.less" ,css))) "compile Less stylesheet")
    (must-run
      (lambda () (run (nix run ".#fennel-palette-css" "--" ,palette)))
      "generate CAT02LMS palette")
    (if (not (= (count-substring (read-file palette) "--palette-") 6))
        (fail "palette output must contain exactly six semantic roles"))
    (write-file css (string-append (read-file css) "\n" (read-file palette)))
    (must-run
      (lambda () (run (nix run ".#fennel-monolith-content" "--" ,catalog)))
      "generate immutable monolith catalogue")
    (verify-catalog catalog)
    (must-run
      (lambda () (run (node "site/app.mjs" ,catalog "index.html" ,html)))
      "render static page through pure renderer")
    (must-run
      (lambda () (run (node ".ci/presentation-smoke.cjs" ,html)))
      "verify static output contract")
    (require-text css "--palette-ink:")
    (require-text css "--palette-ink-on-accent:")
    (write-file (string-append output-dir "/.nojekyll") "")
    (must-run (lambda () (run (rm "-rf" ,temporary))) "remove Pages temporary files")
    (display "pages=pass; frozen two-monolith catalogue; pure renderer; static HTML/CSS only\n")))

;; scsh -s may include the script path as the first command-line argument.
(define (lane-arguments command-arguments)
  (if (and (pair? command-arguments)
           (contains? (car command-arguments) "ci-lanes.scsh"))
      (cdr command-arguments)
      command-arguments))

(let ((args (lane-arguments (command-line))))
  (if (null? args)
      (fail "usage: ci-lanes.scsh AgdaLearner|AgdaTheorem|Pages"))
  (let ((lane (car args)))
    (cond
      ((string=? lane "AgdaLearner") (lane-agda-learner))
      ((string=? lane "AgdaTheorem") (lane-agda-theorem))
      ((string=? lane "Pages") (lane-pages))
      (else (fail (string-append "unknown lane: " lane))))))
