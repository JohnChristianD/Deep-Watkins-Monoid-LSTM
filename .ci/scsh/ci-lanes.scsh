#!/usr/bin/env scsh -s
!#
;; End-to-end lanes: check the canonical Agda source, inventory RUSS, render Pages.

(define (fail message)
  (display "ci-lane=fail: ") (display message) (newline) (exit 1))

(define (read-file path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((chars '()))
        (let ((ch (read-char port)))
          (if (eof-object? ch)
              (list->string (reverse chars))
              (loop (cons ch chars))))))))

(define (write-file path content)
  (if (file-exists? path) (delete-file path))
  (call-with-output-file path (lambda (port) (display content port))))

(define (must-run action label)
  (let ((status (action)))
    (if (not (= status 0))
        (fail (string-append label " exited " (number->string status))))))

(define (agda-command) (or (getenv "AGDA_COMMAND") "agda2hs-agda"))
(define (fennel-command) (or (getenv "FENNEL_COMMAND") "fennel"))

(define (check-agda path)
  (must-run (lambda () (run (,(agda-command) "-i" "." ,path)))
            (string-append "Agda " path)))

(define (check-agda-learner)
  (check-agda "FullCoupled/CanonicalLearnerMonolith.agda")
  (display "learner-kernel-check=pass-relative-to-declared-trust-surface\n"))

(define (check-agda-theorem)
  (check-agda-learner)
  (check-agda "FullCoupled/TheoremsMonolith.agda")
  (display "theorem-kernel-check=pass-relative-to-imports-postulates-primitives-and-options\n"))

(define (check-russ-inventory)
  (must-run (lambda () (run (mkdir "-p" "build"))) "create RUSS audit output directory")
  (must-run
    (lambda ()
      (run (,(fennel-command) ".ci/fennel/russ_certificate.fnl" "build/russ-audit.dhall")))
    "RUSS trust inventory")
  (must-run
    (lambda () (run (dhall "type" "--file" "build/russ-audit.dhall")))
    "Dhall RUSS audit typecheck")
  (display "russ-audit=generated; full-consistency=not-certified\n"))

(define (check-russ)
  (check-agda-theorem)
  (check-russ-inventory))

(define (check-pages)
  (let* ((out (or (getenv "PAGES_OUTPUT_DIR") "build/pages"))
         (palette (string-append out "/palette.css"))
         (base-css (string-append out "/base.css"))
         (css (string-append out "/site.css"))
         (html (string-append out "/index.html")))
    (must-run (lambda () (run (mkdir "-p" ,out))) "create Pages output")
    (must-run (lambda () (run (,(fennel-command) ".ci/fennel/palette_css.fnl" ,palette)))
              "generate palette CSS")
    (must-run (lambda () (run (lessc "site/site.less" ,base-css)))
              "compile Less stylesheet")
    (write-file css (string-append (read-file palette) "\n" (read-file base-css)))
    (must-run (lambda () (run (,(fennel-command) ".ci/fennel/pages.fnl" ,html)))
              "render static HTML")
    (delete-file palette)
    (delete-file base-css)
    (display "static-pages=generated; browser-JavaScript=none\n")))

(define (run-lane lane)
  (cond
    ((string=? lane "AgdaLearner") (check-agda-learner))
    ((string=? lane "AgdaTheorem") (check-agda-theorem))
    ((string=? lane "RUSS") (check-russ))
    ((string=? lane "Pages") (check-pages))
    ((string=? lane "All")
      (check-agda-theorem)
      (check-russ-inventory)
      (check-pages))
    (else (fail (string-append "unknown lane: " lane)))))

(let ((args command-line-arguments))
  (if (null? args)
      (fail "usage: ci-lanes.scsh AgdaLearner|AgdaTheorem|RUSS|Pages|All"))
  (run-lane (car args)))
