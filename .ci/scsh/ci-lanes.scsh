#!/usr/bin/env scsh -s
!#
;; All repository CI orchestration lives here. Dhall declares lane names and
;; project policy; Scheme controls processes, files, checks, and lane dispatch.
;; No Bash command string is evaluated.

(define (fail message)
  (display "ci-lane=fail: ")
  (display message)
  (newline)
  (exit 1))

(define (trim s)
  (let ((n (string-length s)))
    (let left ((i 0))
      (if (and (< i n) (char-whitespace? (string-ref s i)))
          (left (+ i 1))
          (let right ((j n))
            (if (and (> j i) (char-whitespace? (string-ref s (- j 1))))
                (right (- j 1))
                (substring s i j)))))))

(define (read-file path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((chars '()))
        (let ((ch (read-char port)))
          (if (eof-object? ch)
              (list->string (reverse chars))
              (loop (cons ch chars))))))))

(define (write-file path content)
  (if (file-exists? path) (delete-file path))
  (call-with-output-file path
    (lambda (port) (display content port))))

(define (contains? text needle)
  (let ((n (string-length needle)) (size (string-length text)))
    (let loop ((i 0))
      (cond ((> (+ i n) size) #f)
            ((string=? (substring text i (+ i n)) needle) #t)
            (else (loop (+ i 1)))))))

(define (count-substring text needle)
  (let ((n (string-length needle)) (size (string-length text)))
    (let loop ((i 0) (count 0))
      (if (> (+ i n) size)
          count
          (if (string=? (substring text i (+ i n)) needle)
              (loop (+ i n) (+ count 1))
              (loop (+ i 1) count))))))


(define (strip-whitespace s)
  (list->string
    (let loop ((rest (string->list s)) (kept '()))
      (if (null? rest)
          (reverse kept)
          (if (char-whitespace? (car rest))
              (loop (cdr rest) kept)
              (loop (cdr rest) (cons (car rest) kept)))))))

(define (lines-of text)
  (let loop ((rest (string->list text)) (line '()) (lines '()))
    (cond ((null? rest)
           (reverse (if (null? line) lines
                        (cons (list->string (reverse line)) lines))))
          ((char=? (car rest) #\newline)
           (loop (cdr rest) '() (cons (list->string (reverse line)) lines)))
          (else (loop (cdr rest) (cons (car rest) line) lines)))))

(define (require-file path)
  (if (not (file-exists? path))
      (fail (string-append "missing file: " path))))

(define (forbid-file path)
  (if (file-exists? path)
      (fail (string-append "forbidden file remains: " path))))

(define (require-text path needle)
  (if (not (contains? (read-file path) needle))
      (fail (string-append path " lacks: " needle))))

(define (forbid-text path needle)
  (if (contains? (read-file path) needle)
      (fail (string-append path " contains forbidden text: " needle))))

(define (must-run action label)
  (let ((status (action)))
    (if (not (= status 0))
        (fail (string-append label " exited " (number->string status))))))

(define (regex-present? path pattern)
  (let ((status (run (grep "-Eq" ,pattern ,path))))
    (cond ((= status 0) #t)
          ((= status 1) #f)
          (else (fail (string-append "grep failed for " path))))))

(define (require-regex path pattern)
  (if (not (regex-present? path pattern))
      (fail (string-append path " does not match: " pattern))))

(define (forbid-regex path pattern)
  (if (regex-present? path pattern)
      (fail (string-append path " matches forbidden pattern: " pattern))))

(define (temporary-directory)
  (let ((path (trim (run/string (mktemp "-d")))))
    (if (= (string-length path) 0) (fail "mktemp returned an empty path"))
    path))

(define (agda-command)
  (or (getenv "AGDA_COMMAND") "agda2hs-agda"))

(define (check-agda path)
  (must-run (lambda () (run (,(agda-command) "-i" "." ,path)))
            (string-append "Agda " path)))

(define (nix-app app)
  (must-run (lambda () (run (nix run ,app)))
            (string-append "nix run " app)))

(define (require-symbols path symbols)
  (for-each (lambda (symbol) (require-text path symbol)) symbols))

(define (check-graph-agda)
  (for-each check-agda
    '("FullCoupled/Agda2HsSurface.agda"
      "FullCoupled/Agda2HsSemanticExtractor.agda"
      "FullCoupled/Agda2HsTheoremGraphEGraph.agda"
      "FullCoupled/Agda2HsSemanticSearch.agda"
      "FullCoupled/Agda2HsGraphSearchCheck.agda")))

(define (lane-agda-learner)
  (must-run (lambda () (run (,(agda-command) "--version"))) "Agda version")
  (check-graph-agda)
  (check-agda "FullCoupled/CanonicalLearnerMonolith.agda")
  (display "canonical-learner-monolith=kernel-checked-relative-to-trusted-imports-and-postulates\n"))

(define (lane-agda-theorem)
  (check-graph-agda)
  (require-symbols "FullCoupled/Agda2HsSemanticSearch.agda"
    '("graphDependencyOrderRegressionChecked = refl"
      "graphTwoLeafBranchesRegressionChecked = refl"
      "graphCycleIsRejectedRegressionChecked = refl"
      "sourceOnlyLegacyBoundaryRegressionChecked = refl"))
  (check-agda "FullCoupled/CanonicalLearnerMonolith.agda")
  (check-agda "FullCoupled/TheoremsMonolith.agda")
  (display "canonical-learner-monolith=kernel-checked-relative-to-trusted-imports-and-postulates\n")
  (display "theorems-monolith=kernel-checked-relative-to-trusted-imports-postulates-and-primitives\n"))

(define (lane-agda-safe)
  (must-run (lambda () (run (,(agda-command) "--version"))) "Agda version")
  (check-agda "FullCoupled/Agda2HsSurface.agda")
  (display "agda-safe=checked-pure-surface; legacy-monoliths=not-in-pure-kernel-target\n"))

(define (lane-agda2hs)
  (nix-app ".#agda-haskell-pipeline")
  (require-file "build/agda-haskell/FullCoupled/Agda2HsSurface.hs")
  (require-file "build/agda-haskell/agda2hs-manifest.tsv")
  (display "agda2hs=pass\nagda2hs-plugins=none\n"))

(define (verify-catalog path)
  (require-file path)
  (must-run (lambda () (run (node "--check" ,path))) "generated catalog syntax")
  (require-text path "window.MonolithContent")
  (require-text path "source: \"FullCoupled/TheoremsMonolith.agda\"")
  (require-text path "source: \"FullCoupled/CanonicalLearnerMonolith.agda\""))

(define (compile-page-search-js js-dir)
  (must-run (lambda () (run (mkdir "-p" ,js-dir)))
            "create native Agda JavaScript output directory")
  (must-run
    (lambda ()
      (run (,(agda-command) "--js" "--js-es6" "--js-verify"
            ,(string-append "--compile-dir=" js-dir)
            "-i" "." "FullCoupled/Agda2HsSemanticExtractor.agda")))
    "compile pure declaration search with native Agda JavaScript backend")
  (let ((module (string-append
          js-dir "/jAgda.FullCoupled.Agda2HsSemanticExtractor.mjs")))
    (require-file module)
    (must-run (lambda () (run (node "--check" ,module)))
              "validate readable Agda ES module syntax")))
 
(define (lane-fennel-presentation)
  (for-each require-file
    '(".ci/fennel/agda_graph.fnl" ".ci/fennel/ascii_surface.fnl"
      ".ci/fennel/palette_css.fnl" ".ci/presentation-smoke.cjs"
      "FullCoupled/Agda2HsSemanticExtractor.agda"
      "site/app.mjs" "site/site.less"))
  (nix-app ".#fennel-ascii-surface")
  (let* ((tmp (temporary-directory))
         (palette (string-append tmp "/palette.css"))
         (js-dir (string-append tmp "/agda-js"))
         (js-module (string-append js-dir "/jAgda.FullCoupled.Agda2HsSemanticExtractor.mjs"))
         (catalog (string-append tmp "/monolith-content.js")))
    (must-run (lambda () (run (nix run ".#fennel-palette-css" "--" ,palette)))
              "build CAT02LMS palette CSS")
    (if (not (= (count-substring (read-file palette) "--palette-") 6))
        (fail "palette output did not contain exactly six semantic roles"))
    (must-run (lambda () (run (nix run ".#fennel-monolith-content" "--" ,catalog)))
              "generate monolith catalog")
    (verify-catalog catalog)
    (compile-page-search-js js-dir)
    (for-each (lambda (needle) (require-text catalog needle))
      '("FullCoupled/TheoremsMonolith.agda"
        "FullCoupled/CanonicalLearnerMonolith.agda"))
    (must-run (lambda () (run (node ".ci/presentation-smoke.cjs" ,catalog ,js-module)))
              "Agda-generated search/filter semantics smoke")
    (display "fennel-native-presentation=pass\n")
    (must-run (lambda () (run (rm "-rf" ,tmp))) "remove presentation temporary directory")))

(define (lane-pages)
  (lane-fennel-presentation)
  (for-each require-file
    '("FullCoupled/CanonicalLearnerMonolith.agda"
      "FullCoupled/TheoremsMonolith.agda"
      "FullCoupled/Agda2HsSemanticSearch.agda"
      "FullCoupled/Agda2HsSemanticExtractor.agda"
      "FullCoupled/Agda2HsTheoremGraphEGraph.agda"
      ".ci/presentation-contract.dhall" "index.html"))
  (require-text "FullCoupled/Agda2HsSemanticSearch.agda" "requiredPlanComplete")
  (require-text "FullCoupled/Agda2HsSemanticSearch.agda" "import FullCoupled.Agda2HsSemanticExtractor as Extractor")
  (for-each (lambda (path)
      (for-each (lambda (needle) (forbid-text path needle))
        '("Unsafe.Haskell" "MLTT." "UF." "TWA.")))
    '("FullCoupled/Agda2HsSemanticSearch.agda"
      "FullCoupled/Agda2HsSemanticExtractor.agda"
      "FullCoupled/Agda2HsTheoremGraphEGraph.agda"))
  (must-run (lambda () (run (dhall "type" "--file" ".ci/presentation-contract.dhall")))
            "type presentation contract")
  (for-each (lambda (needle) (require-text ".ci/presentation-contract.dhall" needle))
    '("monolithContentGenerator = \".ci/fennel/agda_graph.fnl\""
      "generatedContentScript = \"monolith-content.js\""
      "nativeSearchModule = \"FullCoupled.Agda2HsSemanticExtractor\""
      "compiledSearchModule = \"jAgda.FullCoupled.Agda2HsSemanticExtractor.mjs\""
      "browserRuntime = \"site/app.mjs\""
      "siteEntry = \"index.html\""
      "lessStylesheet = \"site/site.less\""
      "compiledStylesheet = \"site.css\""
      "paletteCssGenerator = \".ci/fennel/palette_css.fnl\""
      "paletteRoleRegistry = \"site/site.less\""))
  (for-each (lambda (needle) (forbid-text "flake.nix" needle))
    '("elmPackages.elm" "elm.js" "site/Main.elm" "site-palette.wasm"
      "palette-loader.js" "maximin_palette.c"))
  (require-text "site/site.less" "Atkinson Hyperlegible Mono")
  (require-text "site/site.less" "Iosevka")
  (require-text ".ci/fennel/palette_css.fnl" "0.7328")
  (require-text ".ci/fennel/palette_css.fnl" "0.4296")
  (require-text ".ci/fennel/palette_css.fnl" "0.9834")
  (forbid-file "site/app.js")
  (require-text "site/app.mjs" "jAgda.FullCoupled.Agda2HsSemanticExtractor.mjs")
  (forbid-text "site/app.mjs" "function filterEntries")
  (forbid-text "site/app.mjs" ".toLowerCase().includes")
  (require-text "FullCoupled/Agda2HsSemanticExtractor.agda" "siteSearchMatches :")
  (require-text "FullCoupled/Agda2HsSemanticExtractor.agda" "siteSearchCaseAndTrimRegression")
  (require-text "FullCoupled/Agda2HsSemanticExtractor.agda" "siteSearchExactScopeRegression")
  (require-text "FullCoupled/Agda2HsSemanticExtractor.agda" "siteSearchMetadataIsNotSearchableRegression")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russianRecursiveMathematicsAssumptions")
  (forbid-text "site/app.mjs" "Mirth")
  (let* ((tmp (temporary-directory))
         (out-dir (or (getenv "PAGES_OUTPUT_DIR") tmp))
         (css (string-append out-dir "/site.css"))
         (palette (string-append tmp "/palette.css"))
         (catalog (string-append out-dir "/monolith-content.js"))
         (js-dir (string-append tmp "/agda-js"))
         (js-module (string-append js-dir "/jAgda.FullCoupled.Agda2HsSemanticExtractor.mjs"))
         (app (string-append out-dir "/app.mjs")))
    (must-run (lambda () (run (mkdir "-p" ,out-dir))) "create Pages output")
    (must-run (lambda () (run (lessc "site/site.less" ,css))) "compile Less")
    (must-run (lambda () (run (nix run ".#fennel-palette-css" "--" ,palette)))
              "generate CAT02LMS palette")
    (write-file css (string-append (read-file css) "\n" (read-file palette)))
    (compile-page-search-js js-dir)
    (must-run (lambda () (run (cp "-R" ,(string-append js-dir "/.") ,out-dir)))
              "copy readable Agda ES modules and their dependency closure")
    (must-run (lambda () (run (cp "site/app.mjs" ,app))) "copy minimal DOM adapter")
    (must-run (lambda () (run (nix run ".#fennel-monolith-content" "--" ,catalog)))
              "generate Pages catalog")
    (verify-catalog catalog)
    (must-run (lambda () (run (node "--check" ,app))) "browser adapter syntax")
    (must-run
      (lambda ()
        (run (node ".ci/presentation-smoke.cjs" ,catalog
              ,(string-append out-dir "/jAgda.FullCoupled.Agda2HsSemanticExtractor.mjs"))))
      "Agda-generated Pages search/filter semantics smoke")
    (require-text css "--palette-ink:")
    (require-text css "--palette-ink-on-accent:")
    (must-run (lambda () (run (cp "index.html" ,(string-append out-dir "/index.html"))))
              "copy Pages entrypoint")
    (write-file (string-append out-dir "/.nojekyll") "")
    (must-run (lambda () (run (rm "-rf" ,tmp))) "remove Pages temporary directory")
    (display "pages-build=pass (Less, pure Agda-generated readable ES modules, minimal DOM adapter; no Elm/Wasm)\n")))

(define (lane-discovery)
  (nix-app ".#agda2hs-semantic-search")
  (let ((report "build/agda2hs-semantic-search/report.txt")
        (manifest "build/agda2hs-semantic-search/agda2hs-semantic-search-manifest.tsv"))
    (require-file report)
    (require-file manifest)
    (for-each (lambda (pattern) (require-regex report pattern))
      '("^theorem-graph-edges=[1-9][0-9]* autonomous-depth-first-chains=[1-9][0-9]*$"
        "^agda2hs autonomous theorem-graph DFS: [1-9][0-9]* maximal dependency chains$"
        "^semantic-laws=[1-9][0-9]* nonreflexive=[1-9][0-9]* composite=[1-9][0-9]*$"
        "^required-plan-count=[1-9][0-9]* required-plan-total=[1-9][0-9]* required-plan-regression=True$"
        "^agda2hs-semantic-port=heuristic-signature-scan-disabled; [1-9][0-9]*/[1-9][0-9]* required plans dependency-closed; bulk-plan-e-graph-saturation=skipped; learner-obligation-roots=[0-9]+; learner-static-graph=(True|False)$"))
    (for-each (lambda (needle) (require-text report needle))
      '("autonomous-regression=True" "graph-branch-regression=True"
        "graph-two-leaf-paths=True" "graph-cycle-rejected=True"
        "graph-path-count-dp=True" "egraph-regression=True egraph-associativity-regression=True"
        "canonical-search-egraph-closed=True"
        "haskell-minus-one-A*=2 proof-backed laws; legacy monolith excluded from pure build"
        "proof-status=diagnostic-only-not-a-consistency-proof"))
    (require-text manifest "proofKernel=Agda")
    (require-text manifest "searchKernel=Agda2Hs")
    (require-text manifest "legacyMonoliths=source-scan-only")
    (nix-app ".#fennel-russ-certificate")
    (must-run (lambda () (run (dhall "type" "--file" ".ci/discovery/russ-global-certificate.dhall")))
              "type-check RUSS trust inventory")
    (for-each (lambda (needle) (require-text ".ci/discovery/russ-global-certificate.dhall" needle))
      '("status = \"DIRECT_SURFACE_INVENTORIED; TRANSITIVE_CONSISTENCY_NOT_PROVED\""
        "directMonolithInventoryPassed = True"
        "jointConsistencyProved = False"
        "russConsistencyCertified = False"
        "consistencyModelProvided = False"
        "directImportClosureTraversed = False"
        "transitiveImportedDependencyClosureCertified = False"
        "globalOptionsSha256"
        "rewriteRuleIdentifiers"
        "importedModulesBySource"))
    (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russianRecursiveMathematicsAssumptions"))
  (nix-app ".#agda2hs-graph-search-check")
  (nix-app ".#scott-strachey-domain-check")
  (nix-app ".#monoid-lstm-stream-check")
  (display "russ-trust-surface-inventory=pass (global consistency not claimed)\n")
  (display "agda-semantic-discovery=pass\n"))

(define (lane-strict-existence)
  (require-text "FullCoupled/TheoremsMonolith.agda" "megaNoEquilibriumGeneralizedWalrasian")
  (require-text "FullCoupled/TheoremsMonolith.agda" "noUnconditionalMegaGeneralizedWalrasianExistence")
  (display "strict-existence-impossibility-graph=source-inventory-only\n"))

(define (lane-isomorphism-transport)
  (require-symbols "FullCoupled/TheoremsMonolith.agda"
    '("isomorphismEqualityTransport" "isomorphismDisequalityTransport"
      "isomorphismIterateConjugacy" "isomorphismNoFiniteCycleTransport"))
  (display "isomorphism-transport-closure=source-inventory-only\n"))

(define (lane-versions)
  (must-run (lambda () (run (ghc "--numeric-version"))) "GHC version")
  (must-run (lambda () (run (,(agda-command) "--version"))) "Agda version")
  (nix-app ".#fennel-smoke")
  (nix-app ".#agda-import-sync")
  (must-run (lambda () (run (dhall "--version"))) "Dhall version")
  (must-run (lambda () (run (z3 "--version"))) "Z3 version")
  (must-run (lambda () (run (emacs "--version"))) "Emacs version")
  (must-run (lambda () (run (emacs "--batch" "--eval" "(require (quote agda2-mode))")))
            "Agda Emacs mode")
  (display "versions=pass\n"))

(define (lane-agda-backends)
  (let* ((tmp (temporary-directory))
         (forth-dir (string-append tmp "/forth"))
         (source (string-append forth-dir "/BackendSmoke.agda"))
         (generated (string-append forth-dir "/BackendSmoke.fth"))
         (gforth-source (string-append forth-dir "/BackendSmoke-gforth.fth"))
         (native (string-append forth-dir "/CcforthSubset-native")))
    (must-run (lambda () (run (nix "build" "-L" ".#agda2forth" "--out-link"
                                  ,(string-append tmp "/agda2forth"))))
              "build Agda2Forth")
    (must-run (lambda () (run (mkdir "-p" ,forth-dir))) "create Forth temp dir")
    (write-file source
      "module BackendSmoke where\nopen import Agda.Builtin.Nat using (Nat; zero; suc; _+_)\ndouble : Nat → Nat\ndouble n = n + n\n")
    (must-run (lambda () (run (cp ,source ,forth-dir))) "copy backend Agda test")
    (must-run
      (lambda () (run (,(string-append tmp "/agda2forth/bin/agda2forth")
                       ,(string-append forth-dir "/BackendSmoke.agda"))))
      "translate Agda to Forth")
    (require-file generated)
    (write-file generated
      (string-append (read-file generated) "\n: MAIN 21 double pass deepDethunk . cr ;\n"))
    (must-run (lambda () (run (cp ,generated ,gforth-source))) "copy GForth test")
    (write-file gforth-source (string-append (read-file gforth-source) "\nMAIN\nbye\n"))
    (let ((value (trim (run/string (gforth ,gforth-source)))))
      (if (not (string=? (strip-whitespace value) "42"))
          (fail (string-append "GForth Agda2Forth output unexpected: " value))))
    (must-run (lambda () (run (nix "build" "-L" ".#ccforth" "--out-link"
                                  ,(string-append tmp "/ccforth"))))
              "build CCForth")
    (let ((subset (string-append forth-dir "/CcforthSubset.fth")))
      (write-file subset ": double 2 * ;\n: MAIN 21 double . cr ;\n")
      (must-run (lambda () (run (,(string-append tmp "/ccforth/bin/ccforth")
                                  "-cc" "gcc" "-entry" "MAIN" "-o" ,native ,subset)))
                "compile CCForth native subset")
      (let ((value (trim (run/string (,native)))))
        (if (not (string=? (strip-whitespace value) "42"))
            (fail (string-append "CCForth GCC output unexpected: " value)))))
    (must-run (lambda () (run (scsh "-c" "(begin (display \"scsh-child-ok\") (newline))")))
              "Scsh child process")
    (display "agda2forth-gforth=pass\nccforth-gcc-native-subset=pass\n")
    (must-run (lambda () (run (rm "-rf" ,tmp))) "remove backend temp directory")))

(define (lane-registry-autoprune)
  (nix-app ".#agda2hs-semantic-search")
  (nix-app ".#agda2hs-graph-search-check")
  (let ((manifest "build/agda2hs-semantic-search/agda2hs-semantic-search-manifest.tsv"))
    (require-file manifest)
    (require-text manifest "legacyMonoliths=source-scan-only")
    (require-text "build/agda2hs-graph-search-check/manifest.tsv" "theoremMonolith=not-loaded")
    (require-text manifest "proofKernel=Agda")
    (require-text manifest "searchKernel=Agda2Hs")
    (require-text manifest "semanticCompletenessCheck=pass"))
  (display "agda-semantic-registry=pass\n"))

;; This single dispatcher replaces the Bash scripts formerly embedded in
;; actions_ci.dhall and the workflow run blocks.
(let ((args (command-line)))
  (if (null? args) (fail "usage: ci-lanes.scsh LANE"))
  (let ((lane (car args)))
    (cond
      ((string=? lane "AgdaLearner") (lane-agda-learner))
      ((string=? lane "AgdaTheorem") (lane-agda-theorem))
      ((string=? lane "AgdaSafe") (lane-agda-safe))
      ((string=? lane "Agda2Hs") (lane-agda2hs))
      ((string=? lane "FennelPresentation") (lane-fennel-presentation))
      ((string=? lane "Pages") (lane-pages))
      ((string=? lane "Discovery") (lane-discovery))
      ((string=? lane "StrictExistenceImpossibility") (lane-strict-existence))
      ((string=? lane "IsomorphismTransport") (lane-isomorphism-transport))
      ((string=? lane "Versions") (lane-versions))
      ((string=? lane "Backends") (lane-agda-backends))
      ((string=? lane "RegistryAutoprune") (lane-registry-autoprune))
      ((string=? lane "All")
       (lane-versions)
       (lane-agda-learner)
       (lane-agda-theorem)
       (lane-discovery)
       (lane-agda-backends))
      (else (fail (string-append "unknown or not yet migrated lane: " lane)))))
)
