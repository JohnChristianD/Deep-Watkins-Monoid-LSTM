#!/usr/bin/env scsh -s
!#
;; Maintained lanes: canonical Agda monoliths, RUSS trust inventory, static Pages.

(define (fail message)
  (display "ci-lane=fail: ") (display message) (newline) (exit 1))

(define (read-file path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((chars '()))
        (let ((ch (read-char port)))
          (if (eof-object? ch)
              (list->string (reverse chars))
              (loop (cons ch chars))))))))

(define (write-file path content)
  (if (file-exists? path) (delete-file path))
  (call-with-output-file path (lambda (port) (display content port))))

(define (contains? text needle)
  (let ((n (string-length needle)) (size (string-length text)))
    (let loop ((i 0))
      (cond ((> (+ i n) size) #f)
            ((string=? (substring text i (+ i n)) needle) #t)
            (else (loop (+ i 1)))))))

(define (require-file path)
  (if (not (file-exists? path)) (fail (string-append "missing file: " path))))

(define (forbid-file path)
  (if (file-exists? path) (fail (string-append "retired path remains: " path))))

(define (require-text path needle)
  (if (not (contains? (read-file path) needle))
      (fail (string-append path " lacks: " needle))))

(define (forbid-text path needle)
  (if (contains? (read-file path) needle)
      (fail (string-append path " contains retired text: " needle))))

(define (must-run action label)
  (let ((status (action)))
    (if (not (= status 0))
        (fail (string-append label " exited " (number->string status))))))

(define (agda-command) (or (getenv "AGDA_COMMAND") "agda2hs-agda"))
(define (fennel-command) (or (getenv "FENNEL_COMMAND") "fennel"))

(define (check-agda path)
  (must-run (lambda () (run (,(agda-command) "-i" "." ,path)))
            (string-append "Agda " path)))

(define (check-policy)
  (for-each require-file
    '("flake.nix"
      "FullCoupled/CanonicalLearnerMonolith.agda"
      "FullCoupled/TheoremsMonolith.agda"
      ".ci/agda/global-options.txt"
      ".ci/actions_ci.dhall"
      ".ci/presentation-contract.dhall"
      ".ci/fennel/pages.fnl"
      ".ci/fennel/palette_css.fnl"
      ".ci/fennel/russ_certificate.fnl"
      ".ci/scsh/ci-lanes.scsh"
      ".ci/scsh/verify-official-nix-surface.scsh"
      "index.html"
      "site/site.less"
      "docs/russ-computational-interpretation-and-consistency.md"))
  (for-each forbid-file
    '("FullCoupled/Agda2HsSemanticSearch.agda"
      "FullCoupled/Agda2HsTheoremGraphEGraph.agda"
      "FullCoupled/Agda2HsGraphSearchCheck.agda"
      "site/MonolithSearch.agda"
      "site/app.mjs"
      ".ci/fennel/agda_graph.fnl"
      ".github/workflows/theorem-registry-autoprune.yml"
      ".ci/scsh/agda-semantic-source-closure.scsh"
      ".ci/scsh/forth-scheme-smoke.scsh"))
  (require-text "flake.nix" "github:NixOS/nixpkgs/")
  (require-text "flake.nix" "github:luafun/luafun/")
  (forbid-text "flake.nix" "ccforth")
  (forbid-text "flake.nix" "pkgs.guile")
  (for-each
    (lambda (path)
      (for-each
        (lambda (needle) (forbid-text path needle))
        '("PreludeInt" "agda2hs-graph-search" "agda2hs-semantic-search"
          "streamly-tools-check" "monoid-lstm-stream-check"
          "scott-strachey-domain-check" "ccforth" "agda2forth"
          "liquid-haskell" "liquidhaskell" "elmPackages" "pkgs.guile")))
    '("flake.nix" ".github/workflows/nix-composition.yml"
      ".github/workflows/github-pages.yml"))
  (require-text "FullCoupled/TheoremsMonolith.agda" "open import Agda.Builtin.Reflection using")
  (require-text "FullCoupled/TheoremsMonolith.agda" "open import Agda.Builtin.Sigma using")
  (for-each
    (lambda (needle) (forbid-text "FullCoupled/TheoremsMonolith.agda" needle))
    '("module ReflectionCompat where"
      "open import MLTT.Plus"
      "open import Ordinals.Notions"
      "Naturals.Multiplication"
      "TypeTopology"))
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "--cohesion")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "--exact-split")
  (require-text "FullCoupled/TheoremsMonolith.agda" "--cohesion")
  (require-text "FullCoupled/TheoremsMonolith.agda" "--exact-split")
  (require-text "flake.nix" "gforth = pkgs.gforth;")
  (for-each
    (lambda (path)
      (require-text path "--with-K")
      (require-text path "--no-guardedness")
      (require-text path "--rewriting")
      (for-each (lambda (needle) (forbid-text path needle))
        '("open import Cubical." "open import Cubical "
          "lawOfExcludedMiddle" "ExcludedMiddle" "classicalAxiom")))
    '("FullCoupled/CanonicalLearnerMonolith.agda"
      "FullCoupled/TheoremsMonolith.agda"))
  (display "official-nix-surface=pass\n"))

(define (check-agda-learner)
  (check-agda "FullCoupled/CanonicalLearnerMonolith.agda")
  (display "learner-kernel-check=pass-relative-to-declared-trust-surface\n"))

(define (check-agda-theorem)
  (check-agda-learner)
  (check-agda "FullCoupled/TheoremsMonolith.agda")
  (display "theorem-kernel-check=pass-relative-to-imports-postulates-primitives-and-options\n"))

(define (check-russ)
  (check-agda-theorem)
  (must-run (lambda () (run (mkdir "-p" "build"))) "create RUSS audit output directory")
  (must-run
    (lambda ()
      (run (,(fennel-command) ".ci/fennel/russ_certificate.fnl" "build/russ-audit.dhall")))
    "RUSS trust inventory")
  (must-run
    (lambda () (run (dhall "type" "--file" "build/russ-audit.dhall")))
    "Dhall RUSS audit typecheck")
  (display "russ-audit=pass; global-consistency=not-certified\n"))

(define (check-pages)
  (check-policy)
  (let* ((out (or (getenv "PAGES_OUTPUT_DIR") "build/pages"))
         (palette (string-append out "/palette.css"))
         (base-css (string-append out "/base.css"))
         (css (string-append out "/site.css"))
         (html (string-append out "/index.html")))
    (must-run (lambda () (run (mkdir "-p" ,out))) "create Pages output")
    (must-run (lambda () (run (,(fennel-command) ".ci/fennel/palette_css.fnl" ,palette)))
              "generate palette CSS")
    (must-run (lambda () (run (lessc "site/site.less" ,base-css)))
              "compile Less stylesheet")
    (write-file css (string-append (read-file palette) "\n" (read-file base-css)))
    (must-run (lambda () (run (,(fennel-command) ".ci/fennel/pages.fnl" ,html)))
              "render static HTML")
    (require-text html "<!doctype html>")
    (require-text html "Canonical learner semantics")
    (require-text html "Theorem and proof monolith")
    (require-text html "Global RUSS consistency: not certified")
    (for-each
      (lambda (needle)
        (if (contains? (read-file html) needle)
            (fail (string-append "published HTML contains forbidden marker: " needle))))
      '("<script" "<input" "<button" "filter-row" "siteSearchMatches"
        "MonolithSearch" "graphAStar" "AStarCostModel"))
    (delete-file palette)
    (delete-file base-css)
    (display "static-pages-contract=pass; browser-javascript=none\n")))

(define (run-lane lane)
  (cond
    ((string=? lane "Policy") (check-policy))
    ((string=? lane "AgdaLearner") (check-policy) (check-agda-learner))
    ((string=? lane "AgdaTheorem") (check-policy) (check-agda-theorem))
    ((string=? lane "RUSS") (check-policy) (check-russ))
    ((string=? lane "Pages") (check-pages))
    ((string=? lane "All") (check-policy) (check-agda-theorem) (check-russ) (check-pages))
    (else (fail (string-append "unknown lane: " lane)))))

(let ((args command-line-arguments))
  (if (null? args)
      (fail "usage: ci-lanes.scsh Policy|AgdaLearner|AgdaTheorem|RUSS|Pages|All"))
  (run-lane (car args)))
