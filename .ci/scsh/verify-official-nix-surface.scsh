#!/usr/bin/env scsh -s
!#
;; Check the narrow maintained Agda/Fennel/Pages surface.
(define (read-file path)
  (call-with-input-file path
    (lambda (p)
      (let loop ((chars '()))
        (let ((ch (read-char p)))
          (if (eof-object? ch)
              (list->string (reverse chars))
              (loop (cons ch chars))))))))
(define (contains? text needle)
  (let ((n (string-length needle)) (size (string-length text)))
    (let loop ((i 0))
      (cond ((> (+ i n) size) #f)
            ((string=? (substring text i (+ i n)) needle) #t)
            (else (loop (+ i 1)))))))
(define (fail msg) (display "surface=fail: ") (display msg) (newline) (exit 1))
(define (require-file path) (if (not (file-exists? path)) (fail (string-append "missing " path))))
(define (forbid-file path) (if (file-exists? path) (fail (string-append "retired file " path))))
(define (require-text path token) (if (not (contains? (read-file path) token)) (fail (string-append path " lacks " token))))
(define (forbid-text path token) (if (contains? (read-file path) token) (fail (string-append path " contains " token))))
(for-each require-file
  '("flake.nix" "FullCoupled/CanonicalLearnerMonolith.agda"
    "FullCoupled/TheoremsMonolith.agda" ".ci/fennel/pages.fnl"
    ".ci/fennel/russ_certificate.fnl" ".ci/fennel/palette_css.fnl"
    ".ci/scsh/ci-lanes.scsh" ".ci/actions_ci.dhall"
    ".ci/presentation-contract.dhall" ".ci/agda/global-options.txt"
    "index.html" "site/site.less"))
(for-each forbid-file
  '("site/MonolithSearch.agda" "site/app.mjs" ".ci/fennel/agda_graph.fnl"
    ".ci/fennel/ascii_surface.fnl" ".ci/presentation-smoke.cjs"
    ".ci/scsh/agda-semantic-source-closure.scsh"
    ".ci/scsh/forth-scheme-smoke.scsh" ".github/workflows/theorem-registry-autoprune.yml"))
(require-text "FullCoupled/TheoremsMonolith.agda" "open import Agda.Builtin.Reflection using")
(require-text "FullCoupled/TheoremsMonolith.agda" "open import Agda.Builtin.Sigma using")
(for-each (lambda (token) (forbid-text "FullCoupled/TheoremsMonolith.agda" token))
  '("module ReflectionCompat where" "open import MLTT.Plus"
    "open import Ordinals.Notions" "Naturals.Multiplication" "TypeTopology"))
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "--flat-split")
  (require-text "FullCoupled/CanonicalLearnerMonolith.agda" "--exact-split")
  (require-text "FullCoupled/TheoremsMonolith.agda" "--flat-split")
  (require-text "FullCoupled/TheoremsMonolith.agda" "--exact-split")
  (require-text "flake.nix" "gforth = pkgs.gforth;")
(for-each (lambda (p)
  (require-text p "--with-K")
  (require-text p "--no-guardedness")
  (require-text p "--rewriting")
  (for-each (lambda (token) (forbid-text p token))
    '("open import Cubical." "lawOfExcludedMiddle" "ExcludedMiddle" "classicalAxiom")))
  '("FullCoupled/CanonicalLearnerMonolith.agda" "FullCoupled/TheoremsMonolith.agda"))
(for-each (lambda (p)
  (for-each (lambda (token) (forbid-text p token))
    '("AStarCostModel" "EGraphCongruence" "graphAStar"
      "agda2hs-graph-search" "agda2hs-semantic-search"
      "ccforth" "agda2forth" "liquidhaskell" "elmPackages" "pkgs.guile")))
  '("flake.nix" ".github/workflows/nix-composition.yml"
    ".github/workflows/github-pages.yml"))
(forbid-text "flake.nix" "ccforth")
(forbid-text "flake.nix" "pkgs.guile")
(display "official-nix-surface=pass\n")
(exit 0)