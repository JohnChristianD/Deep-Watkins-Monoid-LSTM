#!/usr/bin/env scsh -s
!#
;; Fail-closed policy for the Agda2HS, Fennel, and static Pages surface.

(define (read-file path)
  (call-with-input-file path
    (lambda (port)
      (let loop ((chars '()))
        (let ((ch (read-char port)))
          (if (eof-object? ch)
              (list->string (reverse chars))
              (loop (cons ch chars)))))))

(define (contains? text needle)
  (let ((n (string-length needle)) (size (string-length text)))
    (let loop ((i 0))
      (cond ((> (+ i n) size) #f)
            ((string=? (substring text i (+ i n)) needle) #t)
            (else (loop (+ i 1)))))))

(define (fail message)
  (display "official-surface=fail: ")
  (display message)
  (newline)
  (exit 1))

(define (require-file path)
  (if (not (file-exists? path))
      (fail (string-append "missing file: " path))))

(define (forbid-file path)
  (if (file-exists? path)
      (fail (string-append "retired file remains: " path))))

(define (require-text path needle)
  (if (not (contains? (read-file path) needle))
      (fail (string-append path " lacks: " needle))))

(define (forbid-text path needle)
  (if (contains? (read-file path) needle)
      (fail (string-append path " contains retired reference: " needle))))

(for-each require-file
  '("flake.nix"
    ".ci/actions_ci.dhall"
    ".ci/presentation-contract.dhall"
    ".ci/scsh/ci-lanes.scsh"
    ".ci/fennel/monolith_catalog.fnl"
    ".ci/fennel/palette_css.fnl"
    ".ci/fennel/agda_import_sync.fnl"
    ".ci/presentation-smoke.cjs"
    "FullCoupled/CanonicalLearnerMonolith.agda"
    "FullCoupled/TheoremsMonolith.agda"
    "site/app.mjs"
    "site/render.mjs"
    "site/page-model.mjs"
    "site/site.less"
    "index.html"
    ".github/workflows/github-pages.yml"
    ".github/workflows/nix-composition.yml"))

(require-text "flake.nix" "github:NixOS/nixpkgs/")
(require-text "flake.nix" "github:luafun/luafun/")
(require-text "flake.nix" "haskellPackages.agda2hs")
(require-text ".ci/actions_ci.dhall" "AgdaLearner")
(require-text ".ci/actions_ci.dhall" "AgdaTheorem")
(require-text ".ci/actions_ci.dhall" "Pages")
(require-text ".ci/presentation-contract.dhall" "FullCoupled.CanonicalLearnerMonolith")
(require-text ".ci/presentation-contract.dhall" "FullCoupled.TheoremsMonolith")
(require-text ".ci/presentation-contract.dhall" "site/render.mjs")
(require-text ".ci/presentation-contract.dhall" "static HTML and CSS only; no browser JavaScript")

(for-each
  (lambda (path)
    (for-each
      (lambda (needle)
        (forbid-text path needle))
      '("agda2hs-graph-search-check"
        "agda2hs-semantic-search"
        "Agda2HsSemanticSearch"
        "Agda2HsTheoremGraphEGraph"
        "Agda2HsGraphSearchCheck"
        "fennel-smoke"
        "fennel-russ-certificate"
        "liquidhaskell"
        "liquid-haskell"
        "pkgs.guile"
        "elmPackages.elm"
        "site/Main.elm"
        "agda2scheme"
        "jespercockx/agda2scheme")))
  '("flake.nix"
    ".github/workflows/github-pages.yml"
    ".github/workflows/nix-composition.yml"
    ".ci/actions_ci.dhall"))

(for-each forbid-file
  '("FullCoupled/Agda2HsSemanticSearch.agda"
    "FullCoupled/Agda2HsTheoremGraphEGraph.agda"
    "FullCoupled/Agda2HsGraphSearchCheck.agda"
    "FullCoupled/Agda2HsSemanticExtractor.agda"
    ".github/workflows/theorem-registry-autoprune.yml"
    ".ci/fennel/russ_certificate.fnl"
    ".ci/scsh/agda-semantic-source-closure.scsh"
    "site/MonolithSearch.agda"
    "site/Main.elm"
    "site/palette-loader.js"))

(for-each
  (lambda (path)
    (require-text path "open import Haskell.Prelude")
    (require-text path "--with-K")
    (require-text path "--no-guardedness")
    (for-each
      (lambda (needle)
        (forbid-text path needle))
      '("open import Cubical."
        "open import Cubical "
        "import Cubical."
        "import Cubical "
        "--cubical")))
  '("FullCoupled/CanonicalLearnerMonolith.agda"
    "FullCoupled/TheoremsMonolith.agda"))

(require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russianRecursiveMathematicsAssumptions")
(require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russMarkov")
(require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russECT0")
(require-text "FullCoupled/CanonicalLearnerMonolith.agda" "russCountableChoice")
(require-text "FullCoupled/TheoremsMonolith.agda" "russSoundness")
(require-text "FullCoupled/TheoremsMonolith.agda" "russCoreConsistency")
(require-text "FullCoupled/TheoremsMonolith.agda" "russCurrentBasisRelativeConsistency")

(for-each
  (lambda (needle) (forbid-text "site/render.mjs" needle))
  '("node:fs" "process.argv" "writeFile" "readFile" "console."
    "globalThis" "Date.now" "Math.random" "addEventListener" "querySelector"))

(for-each
  (lambda (needle) (forbid-text ".ci/fennel/monolith_catalog.fnl" needle))
  '("(var " "(set " "table.insert"))

(display "official-surface=pass; Agda/RUSS/Fennel/Pages only; retired graph search absent\n")
(exit 0)
