;; Reproducible Forth/Scheme smoke checks, run by scsh itself.
;; The scsh && process form short-circuits on the first failed command.
(if (&& (gforth --version)
        (groff --version)
        (guile --version)
        (scsh -c "(display \"scsh-child-ok\")(newline)")
        (ccforth -version))
    (begin
      (display "forth-scheme-smoke=pass")
      (newline)
      (exit 0))
    (begin
      (display "forth-scheme-smoke=fail")
      (newline)
      (exit 1)))
