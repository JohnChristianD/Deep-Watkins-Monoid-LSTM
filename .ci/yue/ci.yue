-- CI orchestration in YueScript; CPU workers and pure transformations use LuaFun/Lanes.

shellQuote = (value) ->
  "'" .. string.gsub(tostring(value), "'", "'\\''") .. "'"

succeeded = (status) ->
  status == 0 or status == true

runChecked = (label, command) ->
  started = os.time()
  status = os.execute(command)
  elapsed = os.difftime(os.time(), started)
  io.stdout:write("ci-timing: " .. label .. " " .. tostring(elapsed) .. "s\n")
  unless succeeded(status)
    io.stderr:write("ci-lane=fail: " .. label .. " (status " .. tostring(status) .. ")\n")
    os.exit(1)

checkAgdaLearner = ->
  source = "FullCoupled/CanonicalLearnerMonolith.agda"

  runChecked("reject LSTM and epsilon-greedy paths",
    "if grep -Eiq 'lstm|epsilon[ _-]?greedy|e[_-]?z[_-]?greedy' "
      .. shellQuote(source)
      .. "; then echo 'forbidden recurrent/action selector found' >&2; exit 1; fi")

  runChecked("reject DeepSets and postponed FQF code",
    "if grep -Eiq 'DeepSets|FQF|Quantile' " .. shellQuote(source)
      .. "; then echo 'postponed architecture found in learner source' >&2; exit 1; fi")

  runChecked("reject floating-point runtime types",
    "if grep -Eiq '(^|[^[:alnum:]_])(Float|Double|Float32|Float64)([^[:alnum:]_]|$)' "
      .. shellQuote(source)
      .. "; then echo 'floating-point runtime type found' >&2; exit 1; fi")

  runChecked("require Q8.24 and one-step SARSA",
    "for symbol in 'qShift = 24' 'qOne     = 16777216' qRelu qSarsaOneStepTarget "
      .. "networkTrainStepSARSA networkStep networkSequenceVJP "
      .. "networkApplySequenceGradient iterativeCHAD; do "
      .. "grep -Fq \"$symbol\" " .. shellQuote(source) .. " || exit 1; done")

  runChecked("require ReLU on recurrent output",
    "grep -Fq 'hiddenAfter = qRelu mixPre' " .. shellQuote(source))

  print("learner-source-audit=pass; Q8.24; ReLU; one-step SARSA; FQF postponed")

checkAgdaTheorem = ->
  runChecked("parallel Agda typecheck of learner and theorem",
    "luajit build/yue/parallel_agda.lua")

  runChecked("create Agda2HS output directory", "mkdir -p build/agda2hs")
  runChecked("Agda2HS extract canonical learner",
    "agda2hs " .. shellQuote("FullCoupled/CanonicalLearnerMonolith.agda")
      .. " -o " .. shellQuote("build/agda2hs"))

  runChecked("verify extracted Haskell module",
    "test -s build/agda2hs/FullCoupled/CanonicalLearnerMonolith.hs")
  runChecked("create GHC check output directory", "mkdir -p build/ghc")
  runChecked("GHC typecheck extracted learner",
    "ghc-check -fno-code -fforce-recomp -i./build/agda2hs "
      .. "-odir build/ghc -hidir build/ghc "
      .. "build/agda2hs/FullCoupled/CanonicalLearnerMonolith.hs")

  print("agda2hs-and-ghc-check=pass-relative-to-declared-imports-and-primitives")

checkRussAudit = ->
  runChecked("create RUSS audit directory", "mkdir -p build")
  runChecked("generate RUSS trust inventory",
    "luajit build/yue/russ_audit.lua build/russ-audit.dhall")
  runChecked("typecheck RUSS inventory", "dhall type --file build/russ-audit.dhall")
  print("russ-audit=generated; lexical inventory is not a proof certificate")

readFile = (path) ->
  file = assert(io.open(path, "r"), "cannot read " .. path)
  content = file:read("*a")
  file:close()
  content

writeFile = (path, content) ->
  file = assert(io.open(path, "w"), "cannot write " .. path)
  file:write(content)
  file:close()

checkPages = ->
  out = os.getenv("PAGES_OUTPUT_DIR") or "build/pages"
  palette = out .. "/palette.css"
  baseCss = out .. "/base.css"
  css = out .. "/site.css"
  html = out .. "/index.html"

  runChecked("create static Pages output", "mkdir -p " .. shellQuote(out))
  runChecked("generate palette CSS",
    "luajit build/yue/palette_css.lua " .. shellQuote(palette))
  runChecked("compile Less stylesheet",
    "lessc site/site.less " .. shellQuote(baseCss))

  writeFile(css, readFile(palette) .. "\n" .. readFile(baseCss))
  runChecked("render static Pages HTML",
    "luajit build/yue/pages.lua " .. shellQuote(html))

  generatedHtml = readFile(html)
  generatedCss = readFile(css)
  assert(string.find(generatedHtml, 'href="site.css"', 1, true),
    "published HTML is missing its stylesheet link")
  assert(string.find(generatedHtml, "Q8.24 fixed-point", 1, true),
    "published HTML is missing the learner description")
  assert(string.find(generatedHtml, "class=\"russ-status\"", 1, true),
    "published HTML is missing the styled RUSS status")
  assert(string.find(generatedCss, ".russ-status", 1, true),
    "compiled LESS is missing the RUSS status style")
  assert(string.find(generatedCss, ".table-wrap", 1, true),
    "compiled LESS is missing the table layout style")

  os.remove(palette)
  os.remove(baseCss)
  print("static-pages=generated; less-css=validated; browser-JavaScript=none")

actions = {
  AgdaLearner: ->
    checkAgdaTheorem()
    checkAgdaLearner()
  AgdaTheorem: checkAgdaTheorem
  RUSS: ->
    checkAgdaTheorem()
    checkRussAudit()
  Pages: checkPages
  All: ->
    checkAgdaTheorem()
    checkAgdaLearner()
    checkRussAudit()
    checkPages()
}

lane = arg[1] or ""
action = actions[lane]
if action
  action()
else
  io.stderr:write("usage: ci.lua AgdaLearner|AgdaTheorem|RUSS|Pages|All\n")
  os.exit(2)
