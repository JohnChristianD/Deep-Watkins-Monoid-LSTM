-- Lexical RUSS inventory. This is documentation data, not a proof certificate.
fun = require("fun")

sourceFiles = {
  "FullCoupled/CanonicalLearnerMonolith.agda"
  "FullCoupled/TheoremsMonolith.agda"
}

readFile = (path) ->
  file = assert(io.open(path, "r"), "cannot read " .. path)
  content = file:read("*a")
  file:close()
  content

trim = (value) ->
  (string.gsub(string.gsub(value, "^%s+", ""), "%s+$", ""))

countPostulateBlocks = (source) ->
  lines = {}
  for line in string.gmatch(source .. "\\n", "(.-)\\n")
    table.insert(lines, line)
  fun.foldl((count, line) ->
    cleaned = trim(line)
    if cleaned == "postulate" or string.match(cleaned, "^postulate%s+")
      then count + 1
      else count
  , 0, lines)

hasToken = (source, token) ->
  string.find(source, token, 1, true) ~= nil

asDhallBool = (value) ->
  if value then "True" else "False"

sources = fun.totable(fun.map(readFile, sourceFiles))
learner = sources[1]
theorem = sources[2]
learnerPostulates = countPostulateBlocks(learner)
theoremPostulates = countPostulateBlocks(theorem)

outputPath = arg[1] or "build/russ-audit.dhall"
output = assert(io.open(outputPath, "w"), "cannot write " .. outputPath)

lines = {
  "{ canonicalModuleCount = " .. tostring(#sourceFiles)
  ", learnerPostulateBlocks = " .. tostring(learnerPostulates)
  ", theoremPostulateBlocks = " .. tostring(theoremPostulates)
  ", learnerRUSSAssumptionsPresent = " .. asDhallBool(hasToken(learner, "russianRecursiveMathematicsAssumptions : RussianRecursiveMathematicsBasis"))
  ", parametricEnumerabilityPresent = " .. asDhallBool(hasToken(learner, "russParametricEnumerability"))
  ", richmanCountableChoicePresent = " .. asDhallBool(hasToken(learner, "russCountableChoice"))
  ", conditionalExcludedMiddleProfilePresent = " .. asDhallBool(hasToken(theorem, "excludedMiddleTheorem"))
  ", boundedMarkovSearchPresent = " .. asDhallBool(hasToken(theorem, "russSearchBounded"))
  ", registerMachineEvaluatorPresent = " .. asDhallBool(hasToken(learner, "runMachineWithFuel"))
  ", intuitionisticObjectCalculusSoundnessPresent = " .. asDhallBool(hasToken(theorem, "russSoundness"))
  ", objectCalculusRelativeConsistencyPresent = " .. asDhallBool(hasToken(theorem, "russCurrentBasisRelativeConsistency"))
  ", constructiveRiceTheoremPresent = " .. asDhallBool(hasToken(theorem, "RiceTheorem"))
  ", concreteRiceProgrammingSystemPresent = False"
  ", independentCombinedBasisModelProvided = False"
  ", transitiveImportClosureCertified = False"
  ", fullRUSSConsistencyCertified = False"
  "}"
}

output:write(table.concat(lines, "\n") .. "\n")
output:close()
print("russ-audit=generated; lexical inventory is not a proof certificate")
